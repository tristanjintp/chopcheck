# Copier ce fichier en .env.local et renseigner les valeurs.
# Ce fichier ne contient aucune vraie clé et peut être committé.

# Clé OpenAI-Next : utilisée uniquement côté serveur.
# OpenAI-Next expose une API compatible OpenAI et peut router vers Claude.
OPENAI_NEXT_API_KEY=

# Modèle utilisé pour l'analyse des clauses.
OPENAI_NEXT_MODEL=claude-sonnet-4-5

# Utilisé automatiquement si le modèle principal répond HTTP 503.
OPENAI_NEXT_FALLBACK_MODEL=gpt-4o-mini
