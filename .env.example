# Copier ce fichier en .env.local et renseigner les valeurs.
# Ce fichier ne contient aucune vraie clé et peut être committé.

# Clé API Anthropic : utilisée uniquement côté serveur (app/api/analyze).
ANTHROPIC_API_KEY=

# Modèle utilisé pour la lecture et l'analyse (vision + texte).
ANTHROPIC_MODEL=claude-sonnet-5-5
